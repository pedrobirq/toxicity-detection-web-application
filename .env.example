# GEMINI_API_KEY: Используется на сервере Express для резервного демо-инференса (fallback),
# когда внешний Python FastAPI-сервер (MODEL_API_URL) не запущен или недоступен.
# В Google AI Studio задаётся через панель Secrets. Локально — в файле .env (НЕ в .env.example).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MODEL_API_URL: URL вашего Python FastAPI-сервера с обученной моделью RuBertToxicDetector.
# Локально обычно http://127.0.0.1:8000 ; при внешнем деплое — URL контейнера/HuggingFace Space.
# Если переменная не задана или сервер недоступен, используется серверный Gemini fallback.
MODEL_API_URL="http://127.0.0.1:8000"

# MODEL_API_SECRET: Опциональный секретный токен (Bearer) для защиты FastAPI-эндпоинта /predict
# при деплое микросервиса модели на публичный URL.
MODEL_API_SECRET=""

# PORT: Порт Node.js Express-сервера (по умолчанию 3000 для AI Studio и локальной отладки).
PORT="3000"

# APP_URL: Публичный URL развёрнутого веб-приложения.
APP_URL="http://localhost:3000"
